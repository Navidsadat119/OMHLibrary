APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_NAME="OMH Library"
APP_KEY=change-this-to-a-long-random-secret

# Supabase PostgreSQL
# Recommended: Supabase Session Pooler connection details
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-database-password

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_123!
MAX_UPLOAD_MB=50
# Alternatively, a full PostgreSQL connection string can be used:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
